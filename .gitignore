# Untracked folders
/tmp
# Licensed font master: the site serves the subset WOFF2; distributing the
# full OTF is what most font licenses forbid.
src/fonts/Kitora-Bold.otf

# ship-it worktrees live under .claude but must never be committed
.claude/worktrees/

# Trial faces for the dev font lab stay local: demo licenses do not cover
# redistribution, and production never loads them.
src/fonts/try/
