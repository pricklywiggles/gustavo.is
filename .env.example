# Copy to .env.local for development. Never commit the real values.

# Required for the contact form to actually send. Without it, /api/contact
# returns a 500 rather than crashing — get a key from resend.com once the
# domain is verified there (see .claude/stack-it/stack.yaml, transactional
# email delivery slot).
RESEND_API_KEY=

# Both required; the handler returns a 500 without them. No address is committed
# anywhere in the repo. RESEND_FROM must be on a domain verified in Resend.
CONTACT_EMAIL_TO=
RESEND_FROM=

# Sentry error monitoring. All four are optional: without a DSN the SDK
# stays disabled, and without the token the build skips source-map upload.
# The SDK only initializes on Vercel preview and production deploys
# (src/lib/deploy-env.ts), so a DSN here never reports local dev errors.
# DSN: sentry.io project settings > Client Keys. Public by design, hence
# NEXT_PUBLIC_ (the client bundle needs it inlined at build time).
NEXT_PUBLIC_SENTRY_DSN=
# Build-time source-map upload (set these on Vercel, not needed locally):
# org and project slugs from the Sentry URL, plus an organization auth
# token (sentry.io > Settings > Auth Tokens) with project:releases scope.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Decrypts src/fonts/fonts.tar.enc into the licensed WOFF2 faces before dev
# and build (scripts/fonts.mjs). Without it a fresh clone cannot build.
# Ask the owner for the key; it is also set on Vercel and as an Actions secret.
FONTS_KEY=
