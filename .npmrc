# Motion+ ships from its own registry. Auth lives OUTSIDE the repo: locally
# in the user-level npm config, on Vercel via a MOTION_TOKEN env var wired in
# at deploy setup. Never put a literal token in this file.
@motionplus:registry=https://api.motion.dev/npm/

# Same 7-day supply-chain cooldown pnpm-workspace.yaml enforces for pnpm,
# in npm's dialect so any npm-driven tooling honors it too.
min-release-age = 7
